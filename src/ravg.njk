  <!-- ===============================================================
       THIS YEAR'S TASK
       =============================================================== -->
  <section class="section section--light">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <span class="eyebrow">This year's task</span>
          <hr class="rule" />
          <h2>Scout, hand off, deliver.</h2>
          <p class="lede">
            TAR participates in the yearly RTX drone competition. This
            year's task involves a scout Unmanned Aerial Vehicle (UAV) that
            will map the area, discover the landing zone, and communicate
            the location directly to the Delivery Vehicle, UxV (air or
            ground vehicle). The Delivery UxV will receive the location of
            the landing zone, fly or drive to it, and deliver the package to
            the delivery zone.
          </p>
        </div>

        <div class="panel reveal">
          <p class="panel__title">Mission sequence</p>
          <ul class="list-check">
            <li>
              <strong>Map.</strong> The scout UAV launches and surveys the
              arena.
            </li>
            <li>
              <strong>Find.</strong> It identifies the landing zone from the
              air.
            </li>
            <li>
              <strong>Hand off.</strong> The coordinates go straight to the
              delivery vehicle.
            </li>
            <li>
              <strong>Travel.</strong> The delivery UxV flies or drives to
              the zone.
            </li>
            <li>
              <strong>Deliver.</strong> The package is placed in the
              delivery zone.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

