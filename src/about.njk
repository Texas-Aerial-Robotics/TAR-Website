  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Texas Aerial Robotics</h1>
      <p class="lede">
        Texas Aerial Robotics was founded in 2017 by a handful of UT
        students excited by the possibility of building a fully autonomous
        drone from scratch. That passion eventually led to TAR competing
        among top universities from around the world at the International
        Aerial Robotics Competition. Today, TAR provides undergraduate
        students with the opportunity and resources to work on cutting edge
        robotics.
      </p>
    </div>
  </section>

  <section class="section section--light section--tight">
    <div class="container">
      <figure class="photo photo--wide reveal">
        <img
          src="/assets/media/group-room.jpg"
          alt="Members of Texas Aerial Robotics standing together in a conference room"
          loading="lazy"
        />
        <figcaption>The team, fall 2026</figcaption>
      </figure>    </div>
  </section>

  <!-- ===============================================================
       THIS YEAR
       =============================================================== -->
  <section class="section section--dark">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <h2>What we do</h2>
          <p class="lede">
            Our organization is dedicated to the design, development, and
            programming of a fully autonomous drone, with the goal of
            navigating a complex obstacle course by the end of the academic
            year. This ambitious project leverages the collaborative efforts
            of our hardware and software teams, working from the ground up
            to achieve full autonomy.
          </p>
          <p class="lede">
            In addition, we are proud to have a team participating in the
            prestigious RTX Autonomous Vehicles Competition. This
            competition presents a unique pursuit-evasion challenge, where
            both aerial and ground robots are employed in dynamic and
            strategic environments.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/projects.html"
              >Browse the projects</a
            >
            <a class="btn btn--ghost" href="/ravg.html">RAVG team</a>
          </div>
        </div>

        <dl class="plain-list reveal">
          <div>
            <dt>Hardware</dt>
            <dd>Designs and manufactures the drone, mission-specific add-ons, and test rigs.</dd>
          </div>
          <div>
            <dt>Computer Vision</dt>
            <dd>Everything to do with how the drone sees its surroundings.</dd>
          </div>
          <div>
            <dt>Controls</dt>
            <dd>The flight path management code that decides how the drone maneuvers.</dd>
          </div>
          <div>
            <dt>Simulations</dt>
            <dd>Catches bugs in vision and flight planning before anything leaves the ground.</dd>
          </div>
          <div>
            <dt>Business</dt>
            <dd>Industry sponsorship, event planning, and social media.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ===============================================================
       HISTORY
       =============================================================== -->
  <section class="section section--muted">
    <div class="container">
      <div class="section__header">
        <h2>History</h2>
      </div>

      <ul class="tl tl--years">
          <li><span class="tl__when">2017</span><span class="tl__what">Founded by a few UT students who wanted to build a fully autonomous drone from scratch.</span></li>
          <li><span class="tl__when">IARC Mission 7</span><span class="tl__what">Herd ground robots out of an arena with no walls or other 3D cues to navigate by.</span></li>
          <li><span class="tl__when">IARC Mission 8</span><span class="tl__what">Fly a swarm that takes audio or visual commands, put together four pieces of a QR code, and avoid enemy drones, all without GPS.</span></li>
          <li><span class="tl__when">IARC Mission 9</span><span class="tl__what">Fly about two miles to a mast standing in for a ship, match its motion, swap a communications module, and get back in under nine minutes.</span></li>
          <li><span class="tl__when">Spring 2026</span><span class="tl__what">Our RAVG team won the RTX Autonomous Vehicles Competition.</span></li>
      </ul>


    </div>
  </section>

  <!-- ===============================================================
       OFFICERS
       The list itself lives in src/content/about-officer-team.txt.
       Edit that file to change who is on the team; nothing here needs
       touching, however many officers there are.
       =============================================================== -->
  <section class="section section--light">
    <div class="container">
      <div class="section__header">
        <h2>Officers</h2>
      </div>

      <!-- ".cards" rather than ".grid grid--3" so that a last row which is
           not completely full sits centred instead of hugging the left. -->
      <div class="cards">
        {%- for officer in officers %}
        <article class="card officer">
          <div class="officer__photo">
            {%- if officer.photo %}
            <img src="{{ officer.photo }}" alt="{{ officer.name }}, {{ officer.role }}" loading="lazy" />
            {%- else %}
            <span class="officer__ph" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" focusable="false">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </span>
            <span class="officer__note">Portrait coming soon</span>
            {%- endif %}
          </div>
          <div class="officer__info">
            <p class="card__index">{{ officer.role }}</p>
            <h3 class="card__title">{{ officer.name }}</h3>
            {%- if officer.details.length or officer.email %}
            <p class="card__body">
              {{ officer.details | join(", ") }}
              {%- if officer.details.length and officer.email %}<br />{% endif %}
              {%- if officer.email %}
              <a href="mailto:{{ officer.email }}">{{ officer.email }}</a>
              {%- endif %}
            </p>
            {%- endif %}
          </div>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container container--narrow">
      <h2>Want to join?</h2>
      <p>
        We take new members every semester, from every major. Send us a
        message and we will tell you when the next info session is.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact.html">Contact us</a>
      </div>
    </div>
  </section>
