  <!-- ===============================================================
       PROJECT: HIVEMIND
       To add a new project, copy one of these <section> blocks and
       change the id, the heading, and the copy. Alternate between
       "section--light" and "section--muted" so the bands stripe.
       =============================================================== -->
  <section class="section section--light" id="hivemind">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <span class="eyebrow">Project 01 &middot; Swarm</span>
          <hr class="rule" />
          <h2>Hivemind</h2>
          <p class="lede">
            A fleet of small quadcopters that fly as one. Hivemind is
            building a decentralised swarm where every drone runs the same
            controller and negotiates its own role in the air, so the
            formation reshapes itself rather than collapsing when one
            member drops out. Members work on the consensus layer, on
            collision-free trajectory allocation, and on a ground station
            that can task the whole fleet with a single command.
          </p>
        </div>

        <div class="panel reveal">
          <p class="panel__title">
            <span class="icon icon--swarm" aria-hidden="true"></span>
            Focus areas
          </p>
          <ul class="tags">
            <li class="tag">Multi-agent control</li>
            <li class="tag">Consensus algorithms</li>
            <li class="tag">ROS 2</li>
            <li class="tag">UWB ranging</li>
            <li class="tag">Formation flight</li>
            <li class="tag">Ground station UI</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===============================================================
       PROJECT: ORIGAMI
       =============================================================== -->
  <section class="section section--muted" id="origami">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <span class="eyebrow">Project 02 &middot; Folding &amp; throwable</span>
          <hr class="rule" />
          <h2>Origami</h2>
          <p class="lede">
            A drone that folds down to the size of a paperback, gets thrown
            into the air by hand, and unfolds mid-flight to run small jobs
            around a house. The team is designing the spring-loaded arm
            hinges, tuning a controller that has to recover a stable hover
            from an uncontrolled tumble, and teaching it to find its way
            around indoor spaces where there is no GPS to fall back on.
          </p>
        </div>

        <div class="panel reveal">
          <p class="panel__title">
            <span class="icon icon--fold" aria-hidden="true"></span>
            Focus areas
          </p>
          <ul class="tags">
            <li class="tag">Compliant mechanisms</li>
            <li class="tag">Spring hinges</li>
            <li class="tag">Launch-to-hover recovery</li>
            <li class="tag">Indoor VIO</li>
            <li class="tag">Weight budgeting</li>
            <li class="tag">Rapid prototyping</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===============================================================
       PROJECT: PEREGRINE
       =============================================================== -->
  <section class="section section--light" id="peregrine">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <span class="eyebrow">Project 03 &middot; VTOL</span>
          <hr class="rule" />
          <h2>Peregrine</h2>
          <p class="lede">
            A tail-sitter that lifts off straight up like a quadcopter,
            tips over onto a fixed wing, and cruises. Peregrine is chasing
            the transition: the few seconds where the airframe stops being
            a multirotor and starts being an aeroplane. Members work on the
            wing, on the mixed-mode flight controller, and on the
            aerodynamic modelling that tells us whether a design will
            survive the handover before we risk it.
          </p>
        </div>

        <div class="panel reveal">
          <p class="panel__title">
            <span class="icon icon--vtol" aria-hidden="true"></span>
            Focus areas
          </p>
          <ul class="tags">
            <li class="tag">Fixed-wing aero</li>
            <li class="tag">Transition control</li>
            <li class="tag">CFD</li>
            <li class="tag">Composite layup</li>
            <li class="tag">PX4 airframe config</li>
            <li class="tag">Endurance testing</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===============================================================
       RTX DRONE COMPETITION
       Full write-up lives on ravg.html.
       =============================================================== -->
  <section class="section section--dark section--grid" id="rtx">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <span class="eyebrow">Competition team</span>
          <hr class="rule" />
          <h2>RTX Drone Competition</h2>
          <p class="lede">
            TAR participates in the yearly RTX drone competition. This
            year's task involves a scout Unmanned Aerial Vehicle (UAV) that
            will map the area, discover the landing zone, and communicate
            the location directly to the Delivery Vehicle, UxV (air or
            ground vehicle). The Delivery UxV will receive the location of
            the landing zone, fly or drive to it, and deliver the package to
            the delivery zone.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/ravg.html"
              >Go to the RAVG page</a
            >
          </div>
        </div>

        <div class="panel reveal">
          <p class="panel__title">Focus areas</p>
          <ul class="tags">
            <li class="tag">Aerial mapping</li>
            <li class="tag">Landing zone detection</li>
            <li class="tag">UAV to UxV comms</li>
            <li class="tag">Payload delivery</li>
            <li class="tag">Systems integration</li>
          </ul>
        </div>
      </div>
    </div>
