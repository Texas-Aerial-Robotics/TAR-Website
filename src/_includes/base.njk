{#
  The shell every page sits inside: the <head>, the header, and the footer.

  A page supplies the middle. It can set these in its front matter (the
  block between the --- lines at the top of the file):

    title        the browser tab / search result heading   (required)
    description  the one-line summary search engines show
    ogTitle      link-preview title, defaults to `title`
    ogDescription  link-preview text, defaults to `description`
    navKey       which top tab to highlight
    scripts      extra files from assets/js/ to load, e.g. ["carousel.js"]
    noindex      true to keep the page out of search results
    footer       "minimal" for just the copyright strip
    bodyClass    an extra class on <body>, e.g. "body--dark"
#}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{ title }}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}" />
    {%- endif %}
    {%- if noindex %}
    <meta name="robots" content="noindex" />
    {%- endif %}

    <!-- Icons -->
    <link rel="icon" href="/assets/brand/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/assets/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />

    <!-- Link preview card (Slack, iMessage, LinkedIn, ...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:title" content="{{ ogTitle or title }}" />
    {%- if ogDescription or description %}
    <meta
      property="og:description"
      content="{{ ogDescription or description }}"
    />
    {%- endif %}
    <meta property="og:image" content="{{ site.url }}/assets/brand/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle or title }}" />
    {%- if ogDescription or description %}
    <meta
      name="twitter:description"
      content="{{ ogDescription or description }}"
    />
    {%- endif %}
    <meta name="twitter:image" content="{{ site.url }}/assets/brand/og-image.jpg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600&family=Barlow:wght@400;500;600&family=Big+Shoulders+Display:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="stylesheet" href="/assets/css/draft.css" />
  </head>

  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <!-- Loader: a progress bar from 0 to 100%, with a top-down quadcopter
         flying along it. assets/js/draft.js moves the bar and drone together. -->
    <div class="tar-loader" id="tar-loader" role="progressbar" aria-label="Loading Texas Aerial Robotics" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="tar-loader__inner">
        <p class="tar-loader__name">Texas Aerial Robotics</p>
        <div class="tar-loader__track">
          <span class="tar-loader__fill" id="tar-loader-fill"></span>
          <svg class="tar-loader__drone" id="tar-loader-drone" viewBox="0 0 80 80" aria-hidden="true" focusable="false">
            <g stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none">
              <line x1="20" y1="20" x2="60" y2="60" />
              <line x1="60" y1="20" x2="20" y2="60" />
            </g>
            <rect x="31" y="29" width="18" height="22" rx="5" fill="currentColor" />
            <polygon points="40,23 45,30 35,30" fill="var(--orange-bright)" />
            <g class="rotor rotor--a"><circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5" /><line x1="3" y1="16" x2="29" y2="16" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><circle cx="16" cy="16" r="3" fill="currentColor" /></g>
            <g class="rotor rotor--b"><circle cx="64" cy="16" r="14" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5" /><line x1="51" y1="16" x2="77" y2="16" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><circle cx="64" cy="16" r="3" fill="currentColor" /></g>
            <g class="rotor rotor--b"><circle cx="16" cy="64" r="14" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5" /><line x1="3" y1="64" x2="29" y2="64" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><circle cx="16" cy="64" r="3" fill="currentColor" /></g>
            <g class="rotor rotor--a"><circle cx="64" cy="64" r="14" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5" /><line x1="51" y1="64" x2="77" y2="64" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><circle cx="64" cy="64" r="3" fill="currentColor" /></g>
          </svg>
        </div>
        <p class="tar-loader__pct" id="tar-loader-pct" aria-hidden="true">0%</p>
      </div>
    </div>

    <a class="skip-link" href="#main">Skip to content</a>

    {% include "partials/header.njk" %}

    <main id="main">
{{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}

    <!-- Settings the JavaScript needs. Edit them in src/_data/site.js. -->
    <script>
      window.TAR_CONFIG = {
        contactEndpoint: {{ site.contactEndpoint | dump | safe }},
        notifyEndpoint: {{ site.notifyEndpoint | dump | safe }},
        demoMode: {{ site.demoMode | dump | safe }},
        contactEmail: {{ site.contactEmail | dump | safe }}
      };
    </script>
    <script src="/assets/js/site.js"></script>
    <script src="/assets/js/draft.js"></script>
    {%- for script in scripts %}
    <script src="/assets/js/{{ script }}"></script>
    {%- endfor %}
  </body>
</html>
