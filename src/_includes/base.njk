{#
  The shell every page sits inside: the <head>, the header, and the footer.

  A page supplies the middle. It can set these in its front matter (the
  block between the --- lines at the top of the file):

    title        the browser tab / search result heading   (required)
    description  the one-line summary search engines show
    ogTitle      link-preview title, defaults to `title`
    ogDescription  link-preview text, defaults to `description`
    navKey       which top tab to highlight
    scripts      extra files from assets/js/ to load, e.g. ["carousel.js"]
    noindex      true to keep the page out of search results
    footer       "minimal" for just the copyright strip
    bodyClass    an extra class on <body>, e.g. "body--dark"
#}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{ title }}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}" />
    {%- endif %}

    {%- if noindex or not site.isProduction %}
    <!-- Either this page asked to stay out of search results, or this is a
         Netlify deploy preview, which is public but must not compete with
         the real site. See `isProduction` in src/_data/site.js. -->
    <meta name="robots" content="noindex, follow" />
    {%- else %}
    <!-- The one address for this page. Netlify serves /about, /about.html,
         and (for the home page) /index.html as three copies of the same
         thing; this is what tells a search engine which one counts, so the
         page's credit is not split three ways. -->
    <link rel="canonical" href="{{ page.url | canonical }}" />

    <!-- max-image-preview lets Google show a large thumbnail; the other two
         stop it trimming the snippet. All three only widen what it may
         show, never what it may crawl. -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    {%- endif %}

    <!-- Icons -->
    <link rel="icon" href="/assets/brand/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/assets/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#0d0d0f" />
    <meta name="application-name" content="{{ site.name }}" />

    <!-- Link preview card (Slack, iMessage, LinkedIn, ...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content="{{ page.url | canonical }}" />
    <meta property="og:title" content="{{ ogTitle or title }}" />
    {%- if ogDescription or description %}
    <meta
      property="og:description"
      content="{{ ogDescription or description }}"
    />
    {%- endif %}
    <meta property="og:image" content="{{ '/assets/brand/og-image.jpg' | absolute }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.name }} — {{ site.university }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle or title }}" />
    {%- if ogDescription or description %}
    <meta
      name="twitter:description"
      content="{{ ogDescription or description }}"
    />
    {%- endif %}
    <meta name="twitter:image" content="{{ '/assets/brand/og-image.jpg' | absolute }}" />
    <meta name="twitter:image:alt" content="{{ site.name }} — {{ site.university }}" />

    {%- if not noindex and site.isProduction %}
    <!-- Who we are, in the format search engines read. Built in lib/seo.js
         from the details in src/_data/site.js. -->
    {% structuredData page.url, title, description, navKey %}
    {%- endif %}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/css/site.css" />
  </head>

  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>

    {% include "partials/header.njk" %}

    <main id="main">
{{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}

    <!-- Settings the JavaScript needs. Edit them in src/_data/site.js. -->
    <script>
      window.TAR_CONFIG = {
        contactEndpoint: {{ site.contactEndpoint | dump | safe }},
        notifyEndpoint: {{ site.notifyEndpoint | dump | safe }},
        contactEmail: {{ site.contactEmail | dump | safe }}
      };
    </script>
    <script src="/assets/js/site.js"></script>
    {%- for script in scripts %}
    <script src="/assets/js/{{ script }}"></script>
    {%- endfor %}
  </body>
</html>
