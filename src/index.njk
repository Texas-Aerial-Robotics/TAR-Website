---
title: "Texas Aerial Robotics | Autonomous drones built at UT Austin"
description: "Texas Aerial Robotics is an undergraduate research organization at the University of Texas at Austin dedicated to designing, building, and programming fully autonomous drones."
ogTitle: "Texas Aerial Robotics"
ogDescription: "Autonomous drones, built by students at The University of Texas at Austin."
navKey: "home"
---

  <!-- ===============================================================
       HERO. A real photo from the Media folder behind the headline.
       Change the image by editing --hero-photo below.
       =============================================================== -->
  <section class="hero hero--photo" style="--hero-photo: url('/assets/media/hero-lab.jpg')">
    <div class="container hero__layout hero__layout--single">
      <div class="hero__copy">
        <h1 class="hero__title">
          Texas Aerial Robotics<br />
          at UT Austin
        </h1>
        <p class="lede hero__lede">
          Texas Aerial Robotics is a team of UT Austin undergraduates. We
          design the airframes, write the software, and fly them.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/projects.html">See what we build</a>
          <a class="btn btn--ghost" href="/about.html">Meet the team</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===============================================================
       WHO ARE WE?
       =============================================================== -->
  <section class="section section--light">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <h2>About TAR</h2>
          <p class="lede">
            Based at The University of Texas at Austin, Texas Aerial
            Robotics designs, builds, and programs drones that fly
            themselves.
          </p>
          <p class="lede">
            New members work on a real project from their first week, next to
            people who have done it before.
          </p>
          <div class="btn-row">
            <a class="btn btn--outline" href="/about.html">About the team</a>
          </div>
        </div>

        <figure class="photo reveal">
          <img
            src="/assets/media/group-park.jpg"
            alt="Members of Texas Aerial Robotics posing together outdoors at a park social"
            loading="lazy"
          />
          <figcaption>Park social, fall 2026</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===============================================================
       PROJECTS. The list comes from src/content/projects-current.txt.
       =============================================================== -->
  <section class="section section--muted">
    <div class="container">
      <div class="section__header">
        <h2>Current projects</h2>
        <p class="lede">
          Every member joins a project team and ships real hardware with
          real software beside it.
        </p>
      </div>

      <div class="missions">
        {%- for project in projects.current %}
        <a
          class="mission mission--photo reveal"
          href="/projects.html#{{ project.link }}"
        >
          <span class="mission__photo">
            {%- if project.photo %}
            <img src="{{ project.photo }}" alt="{{ project.name }}" loading="lazy" />
            {%- else %}
            <span class="photo-slot"><span class="photo-slot__name">{{ project.name }}</span><span class="photo-slot__note">Photo coming</span></span>
            {%- endif %}
          </span>
          <span class="mission__body">
            <span class="mission__name">{{ project.name }}</span>
            <span class="mission__summary">{{ project.summary }}</span>
          </span>
          <span class="mission__go" aria-hidden="true">View</span>
        </a>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- ===============================================================
       COMPETITION
       =============================================================== -->
  <section class="section section--dark">
    <div class="container">
      <div class="split">
        <div class="reveal">
          <h2>RTX competition</h2>
          <p class="lede">
            Our RAVG team races in the RTX Autonomous Vehicles Competition,
            pairing aerial and ground robots in fast, strategic arenas. We won
            the competition in spring 2026.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/ravg.html">Meet the RAVG team</a>
          </div>
        </div>

        <figure class="photo reveal">
          <img
            src="/assets/media/lab.jpg"
            alt="Team members gathered around drone hardware on a lab bench"
            loading="lazy"
          />
          <figcaption>In the lab at a recruiting night</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===============================================================
       PARTNERS. Logos sit directly on the page, no tiles.
       =============================================================== -->
  <section class="section section--light">
    <div class="container">
      <div class="section__header section__header--center">
        <h2>Our sponsors</h2>
        <p class="lede">
          Licenses, parts, and funding from these partners become flight
          hours for undergraduates building autonomous systems.
        </p>
      </div>

      <div class="logo-wall reveal">
        <div class="logo-slot">
          <img src="/assets/company/platinum/Altium_logo.svg" alt="Altium" />
        </div>
        <div class="logo-slot">
          <img src="/assets/company/platinum/ANSYS_logo.png" alt="ANSYS" />
        </div>
        <div class="logo-slot">
          <img
            src="/assets/company/platinum/Solidworks_logo.webp"
            alt="Solidworks"
          />
        </div>
        <div class="logo-slot">
          <img
            src="/assets/company/gold/ASE_Logo.svg"
            alt="UT Aerospace Engineering"
          />
        </div>
      </div>

      <div class="btn-row" style="justify-content: center">
        <a class="btn btn--outline" href="/partners.html"
          >Partnership tiers</a
        >
      </div>
    </div>
  </section>

  <!-- ===============================================================
       CALL TO ACTION
       =============================================================== -->
  <section class="cta-band">
    <div class="container container--narrow">
      <h2>Join TAR</h2>
      <p>
        No experience required, just curiosity. We train new members on the
        tools, and everyone works on a real project from day one.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact.html">Get in touch</a>
        <a class="btn btn--outline" href="/donate.html">Support the team</a>
      </div>
    </div>
  </section>
