# ==========================================================================
# Example environment variables
# --------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values you want to test:
#
#     cp .env.example .env
#
# `npm run netlify` reads .env automatically. .env is git-ignored, so real
# values stay on your machine. THIS repository is public — never put a real
# secret in this example file, or anywhere else that gets committed.
#
# In production these live in Netlify, under
# Site configuration -> Environment variables.
# ==========================================================================

# Posts the contact form to a Discord channel as an embed.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=

# Optional: also email the message. See README.md.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO=
# CONTACT_FROM=

# Optional: also POST the raw JSON somewhere else (Slack, Zapier, ...).
# CONTACT_WEBHOOK_URL=
# CONTACT_WEBHOOK_SECRET=
